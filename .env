# PostgreSQL
POSTGRES_USER=phishing_user
POSTGRES_PASSWORD=phishing_pass
POSTGRES_DB=phishing_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://phishing_user:phishing_pass@db:5432/phishing_db

# Frontend (used at build time for client-side API calls — must be reachable
# from the browser, not from inside the Docker network)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM generation (optional; fallback template generator used when unset)
# Groq free tier: https://console.groq.com/keys
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
